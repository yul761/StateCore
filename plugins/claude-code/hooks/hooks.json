{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact|fork", "hooks": [{ "type": "command", "command": "npx -y statecore-mcp@1.0.0 hook session-start" }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "npx -y statecore-mcp@1.0.0 hook user-prompt", "async": true }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "npx -y statecore-mcp@1.0.0 hook stop", "async": true }] }
    ],
    "PreCompact": [
      { "matcher": "auto|manual", "hooks": [{ "type": "command", "command": "npx -y statecore-mcp@1.0.0 hook pre-compact" }] }
    ]
  }
}
